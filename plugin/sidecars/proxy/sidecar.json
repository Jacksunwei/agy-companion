{
  "command": "bash",
  "args": [
    "../../scripts/run-companion.sh",
    "serve",
    "--adopt-running",
    "--auto-enable-launcher"
  ],
  "restart_policy": "on-failure",
  "display_name": "Antigravity Companion",
  "description": "Local loopback Gemini pass-through proxy with live session monitoring, usage analytics, and BYOM settings.",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Antigravity Companion",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Antigravity Companion"
      }
    ]
  }
}
